{
  "uid": "smlops-ticket-router",
  "title": "Ticket router",
  "tags": [
    "smlops",
    "mlops"
  ],
  "description": "Generated by scripts/grafana_dashboard.py; edit the script, not this file.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Which model is serving",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "table",
      "title": "Serving model",
      "description": "Name, registry version and signed digest of every model reporting. More than one digest for over 30 minutes is a stuck rollout.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name, version, digest) (smlops_model_info)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 2
    },
    {
      "type": "row",
      "title": "Is it healthy",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(smlops_predict_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "description": "Red is the serving objective: p95 under 250 ms (configs/serving.yaml).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(smlops_predict_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(smlops_predict_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(smlops_predict_latency_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              },
              {
                "color": "#cf222e",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Tickets routed by team",
      "description": "Tickets a minute per predicted team.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team) (rate(smlops_tickets_routed_total[5m])) * 60",
          "legendFormat": "{{team}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "row",
      "title": "Is traffic still like the training data",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Predicted team mix vs training (PSI)",
      "description": "Population stability of predicted teams against the model's signed training profile. Amber warns, red starts retraining.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(smlops_live_psi_predicted_team)",
          "legendFormat": "PSI",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              },
              {
                "color": "#bf8700",
                "value": 0.1
              },
              {
                "color": "#cf222e",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Unknown words vs the model's baseline",
      "description": "Share of words the model's vectorizer does not know, as a multiple of its rate on held-out tickets. 1.0 means as usual.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 9,
        "y": 21,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(smlops_live_new_word_ratio)",
          "legendFormat": "ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              },
              {
                "color": "#bf8700",
                "value": 1.15
              },
              {
                "color": "#cf222e",
                "value": 1.3
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 9
    },
    {
      "type": "stat",
      "title": "Tickets in the drift window",
      "description": "Drift is judged only once the window holds 200 tickets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(smlops_live_window_tickets)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Retraining requests from alerts",
      "description": "What the alert relay did with drift alerts in the past hour: dispatched starts a retraining run, suppressed falls inside its cooldown, failed means retraining did not start and TicketRouterRetrainTriggerFailing fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(smlops_relay_retrain_requests_total[1h]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 11
    },
    {
      "type": "row",
      "title": "Is it still routing tickets correctly",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Live accuracy below the held-out bar",
      "description": "The model's held-out accuracy (signed into it) minus its accuracy on tickets agents confirmed. Red starts retraining: real harm, not just drift.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(smlops_live_accuracy_drop)",
          "legendFormat": "drop",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              },
              {
                "color": "#cf222e",
                "value": 0.03
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 13
    },
    {
      "type": "stat",
      "title": "Tickets agents confirmed",
      "description": "Accuracy is judged once the window holds 100 confirmed tickets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(smlops_live_labelled_tickets)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Live recall per team",
      "description": "Of the tickets agents confirmed for each team, the share the model routed there. One team falling here can hide inside an overall accuracy that looks fine.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (team) (smlops_live_recall)",
          "legendFormat": "{{team}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 15
    },
    {
      "type": "row",
      "title": "Is anyone abusing the endpoint",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Rejected keys, exhausted budgets, refused feedback",
      "description": "Requests a minute. Feedback refused as other-client is a client confirming tickets it never sent: a poisoning attempt or a broken integration. The audit log names the client of every request that presented a valid key.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(smlops_predict_requests_total{status=\"401\"}[5m])) * 60",
          "legendFormat": "no valid key",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(smlops_predict_requests_total{status=~\"413|429\"}[5m])) * 60",
          "legendFormat": "over budget",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (outcome) (rate(smlops_feedback_requests_total{outcome!=\"counted\"}[5m])) * 60",
          "legendFormat": "feedback refused: {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 17
    }
  ]
}
