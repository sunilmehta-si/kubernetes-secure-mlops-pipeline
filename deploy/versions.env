# Every platform component, pinned. Checked against each project's GitHub releases on 2026-10-17; all publish arm64.
# Scripts source this file; Dependabot does not track it, so bump versions here deliberately and rerun the cluster CI.
# Bump only to a release at least 14 days old: `smlops versions` says from which date each newer one qualifies.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0
CERT_MANAGER_VERSION=v1.20.4
KSERVE_VERSION=v0.21.0
KYVERNO_VERSION=v1.19.2
KYVERNO_CLI_SHA256_LINUX_X86_64=357eaf1df8bc24ddd5a73979fadeaae6a032e8710f11af264229756e4956bf4a
ZOT_VERSION=v2.1.22
COSIGN_VERSION=v3.1.4
# The cluster's image registry: a zot container on the kind network, reachable under one name everywhere.
REGISTRY=kind-registry:5000
# The only kubectl context the cluster scripts will act on (kind names it after the cluster in deploy/kind.yaml).
KIND_CONTEXT=kind-smlops
# Prometheus (promtool for alert unit tests in CI; the in-cluster server uses the same version). Checked 2026-10-20.
PROMETHEUS_VERSION=v3.15.1
PROMETHEUS_SHA256_LINUX_AMD64=6a726885328ad9efebbf36e876ce2fb6225468a71fd1e7ce3ba666d5f4d97a84
# Alertmanager (amtool for routing tests in CI; the in-cluster server uses the same version). Checked 2026-10-21.
ALERTMANAGER_VERSION=v0.34.1
ALERTMANAGER_SHA256_LINUX_AMD64=265b9d1e55ef0d5306a436018af6d2b686c2ce051f03d968f7464ecb1372a7e8
# Argo CD (core install: no UI or API server) syncs releases on the CI cluster; oras pushes them there as OCI
# artifacts. Both at least two weeks old when pinned on 2026-10-21; scripts check their checksums.
ARGOCD_VERSION=v3.5.6
ORAS_VERSION=v1.3.6
ORAS_SHA256_LINUX_AMD64=66fb0ad7206f3f6fa77ed5b552049d364ccf4b50b1684554f731f76302b52ca0
# Helm renders the ticket-router chart into each environment's release (smlops render-release). Pinned 2026-10-22.
HELM_VERSION=v4.3.1
HELM_SHA256_LINUX_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
# uv resolves and installs the Python dependencies from uv.lock, in CI (.github/actions/setup-uv) and in the image.
# Pinned 2026-10-24 with the SHA-256 of its Linux x86_64 release and the digest of its image.
UV_VERSION=0.13.5
UV_SHA256_LINUX_X86_64=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f
# Checksums of the release archives the workflows download sit next to their versions, so a bump is one file.
# osv-scanner checks uv.lock against the OSV database on every CI run (ci.yml, job dependencies).
OSV_SCANNER_VERSION=v2.7.0
OSV_SCANNER_SHA256_LINUX_AMD64=160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b
