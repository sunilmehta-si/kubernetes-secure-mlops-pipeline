{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ticket-router values",
  "description": "Unknown keys are errors: a typo such as replicaz must fail the render, not be ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "model",
    "server",
    "replicas",
    "clients",
    "disruptionBudget"
  ],
  "definitions": {
    "digestRef": {
      "type": "string",
      "description": "registry/repository@sha256:<64 hex>, or empty in the chart defaults (a release must set it)",
      "pattern": "^$|^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$"
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9.]+(m|Ki|Mi|Gi)?$"
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory"
      ],
      "properties": {
        "cpu": {
          "$ref": "#/definitions/quantity"
        },
        "memory": {
          "$ref": "#/definitions/quantity"
        }
      }
    }
  },
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "image"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "image": {
          "$ref": "#/definitions/digestRef"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "ticketsPerMinute",
        "burst",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/digestRef"
        },
        "ticketsPerMinute": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "burst": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "$ref": "#/definitions/resourceList"
            },
            "limits": {
              "$ref": "#/definitions/resourceList"
            }
          }
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespaceLabel"
      ],
      "properties": {
        "namespaceLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "disruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAvailable"
      ],
      "properties": {
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
